# Core runtime
FLAGO_ENV=dev
FLAGO_LOG_LEVEL=INFO
FLAGO_HOST=127.0.0.1
FLAGO_PORT=8000
FLAGO_BASE_URL=http://127.0.0.1:8000
FLAGO_SQLITE_PATH=data/flago.sqlite3
FLAGO_START_LONG_CONNECTION=false
FLAGO_AGENT_MODE=legacy
FLAGO_AGENT_MAX_STEPS=4
FLAGO_AGENT_TOOL_TIMEOUT_SECONDS=30

# Admin
FLAGO_ADMIN_ENABLED=true
FLAGO_ADMIN_CONFIG_PATH=.env
FLAGO_ADMIN_SESSION_SECRET=

# Assistant
FLAGO_ASSISTANT_DEFAULT_NAME=飞灵
FLAGO_ASSISTANT_DEFAULT_PROFILE=简洁、可靠、直接，优先给出可执行的回答。

# Feishu app and OAuth
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_NAME=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_AUTH_BASE_URL=https://accounts.feishu.cn
FEISHU_DOCS_BASE_URL=https://docs.feishu.cn
FEISHU_HTTP_PROXY=
FEISHU_OAUTH_SCOPES=auth:user.id:read drive:drive.search:readonly search:docs:read docx:document:readonly docx:document docs:document.media:download wiki:node:read wiki:wiki:readonly sheets:spreadsheet:readonly sheets:spreadsheet bitable:app:readonly bitable:app base:table:read base:record:read base:record:create base:record:update base:record:delete base:field:read base:view:read
FLAGO_OAUTH_ENABLE_OFFLINE_ACCESS=false
FLAGO_OAUTH_STATE_TTL_SECONDS=600

# Model routing
FLAGO_DEFAULT_PROVIDER=gemini
FLAGO_DEFAULT_MODEL=
FLAGO_MODEL_TEST_MAX_OUTPUT_TOKENS=1024
FLAGO_MODEL_PROVIDER_CONCURRENCY_LIMIT=4
FLAGO_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
FLAGO_OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=
FLAGO_OPENAI_COMPATIBLE_HTTP_PROXY=

# Gemini provider
GEMINI_API_KEY=
GEMINI_DISPLAY_NAME=Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_THINKING_BUDGET=
GEMINI_BASE_URL=
GEMINI_HTTP_PROXY=

# OpenAI provider
OPENAI_API_KEY=
OPENAI_DISPLAY_NAME=OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_DISPLAY_NAME=DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen provider
QWEN_API_KEY=
QWEN_DISPLAY_NAME=Qwen
QWEN_BASE_URL=
QWEN_MODEL=

# Doubao provider
DOUBAO_API_KEY=
DOUBAO_DISPLAY_NAME=Doubao
DOUBAO_BASE_URL=
DOUBAO_MODEL=

# Minimax provider
MINIMAX_API_KEY=
MINIMAX_DISPLAY_NAME=Minimax
MINIMAX_BASE_URL=
MINIMAX_MODEL=

# Claude provider
ANTHROPIC_API_KEY=
ANTHROPIC_DISPLAY_NAME=Claude
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_HTTP_PROXY=

# Media and workflow providers
SEEDANCE_API_KEY=
SEEDANCE_DISPLAY_NAME=Seedance
SEEDANCE_BASE_URL=
SEEDANCE_MODEL=
COMFYUI_DISPLAY_NAME=ComfyUI
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COZE_API_KEY=
COZE_DISPLAY_NAME=Coze
COZE_BASE_URL=
DIFY_API_KEY=
DIFY_DISPLAY_NAME=Dify
DIFY_BASE_URL=

# Resource and attachment reading
FLAGO_RESOURCE_SEARCH_ENABLED=true
FLAGO_RESOURCE_SEARCH_RESULT_LIMIT=5
FLAGO_RESOURCE_SEARCH_READ_LIMIT=3
FLAGO_MAX_RESOURCE_CHARS=120000
FLAGO_MAX_MESSAGE_CHARS=20000
FLAGO_MAX_SHEET_ROWS=200
FLAGO_MAX_SHEET_COLUMNS=26
FLAGO_MAX_BITABLE_RECORDS=200
FLAGO_DOC_BLOCK_SCAN_LIMIT=1000
FLAGO_EMBEDDED_FILE_LIMIT=3
FLAGO_EMBEDDED_FILE_MAX_BYTES=20971520
FLAGO_EMBEDDED_FILE_MAX_CHARS=40000
FLAGO_EMBEDDED_LINK_LIMIT=20
FLAGO_ATTACHMENT_OCR_ENABLED=false
FLAGO_ATTACHMENT_OCR_COMMAND=tesseract
FLAGO_ATTACHMENT_OCR_LANGUAGES=chi_sim+eng
FLAGO_ATTACHMENT_OCR_TIMEOUT_SECONDS=15
FLAGO_ATTACHMENT_OCR_MAX_PIXELS=20000000
FLAGO_ATTACHMENT_VISION_ENABLED=false
FLAGO_ATTACHMENT_VISION_PROVIDER=gemini
FLAGO_ATTACHMENT_VISION_MODEL=
FLAGO_ATTACHMENT_VISION_PROMPT=请用中文简洁说明这张图片的内容；如果图片包含可读文字，请尽量完整转写关键文字。
FLAGO_ATTACHMENT_VISION_MAX_BYTES=5242880
FLAGO_ATTACHMENT_VISION_MAX_PIXELS=20000000
FLAGO_ATTACHMENT_MEDIA_UNDERSTANDING_ENABLED=false
FLAGO_ATTACHMENT_MEDIA_UNDERSTANDING_PROVIDER=gemini
FLAGO_ATTACHMENT_MEDIA_UNDERSTANDING_MODEL=
FLAGO_ATTACHMENT_MEDIA_UNDERSTANDING_PROMPT=请用中文简洁说明这个媒体文件的主要内容；如果是音频，请尽量转写关键语句；如果是视频，请概述画面和可听内容。
FLAGO_ATTACHMENT_MEDIA_UNDERSTANDING_MAX_BYTES=20971520
FLAGO_PDF_DEFAULT_PAGES=2
FLAGO_PDF_MAX_PAGES=10
FLAGO_PDF_EXTRACT_TIMEOUT_SECONDS=20

# Web reading
FLAGO_WEB_READ_ENABLED=true
FLAGO_WEB_TIMEOUT_SECONDS=20
FLAGO_WEB_MAX_BYTES=1000000
FLAGO_WEB_ALLOWED_HOSTS=
FLAGO_WEB_BLOCKED_HOSTS=

# Context and memory
FLAGO_CONTEXT_RECENT_MESSAGE_LIMIT=50
FLAGO_CONTEXT_RECENT_TIME_WINDOW_HOURS=24
FLAGO_CONTEXT_CACHE_TTL_HOURS=24
FLAGO_CONTEXT_CACHE_REFRESH_SECONDS=60
FLAGO_CONTEXT_INJECT_MESSAGE_LIMIT=8
FLAGO_CONTEXT_MAX_CHARS=6000
FLAGO_MEMORY_STORE_RAW_TEXT=false
FLAGO_MEMORY_ITEM_MAX_CHARS=2000
FLAGO_MEMORY_CONTEXT_MAX_CHARS=4000

# Writeback
FLAGO_WRITEBACK_ENABLED=false
FLAGO_WRITEBACK_AUTO_EXECUTE_ENABLED=false
FLAGO_WRITEBACK_CONFIRMATION_MODE=always
FLAGO_PENDING_ACTION_TTL_SECONDS=1800
FLAGO_WRITEBACK_DEDUPE_WINDOW_SECONDS=600
FLAGO_CARD_ACTION_ACK_TIMEOUT_SECONDS=2
FLAGO_MAX_WRITEBACK_CHARS=20000
FLAGO_MAX_WRITEBACK_CELLS=1000
