# Core runtime
FLGO_ENV=dev
FLGO_LOG_LEVEL=INFO
FLGO_HOST=127.0.0.1
FLGO_PORT=8000
FLGO_BASE_URL=http://127.0.0.1:8000
FLGO_SQLITE_PATH=data/flgo.sqlite3
FLGO_START_LONG_CONNECTION=false
FLGO_AGENT_MODE=legacy
FLGO_AGENT_MAX_STEPS=4
FLGO_AGENT_TOOL_TIMEOUT_SECONDS=30

# Admin
FLGO_ADMIN_ENABLED=true
FLGO_ADMIN_CONFIG_PATH=.env
FLGO_ADMIN_SESSION_SECRET=

# Assistant
FLGO_ASSISTANT_DEFAULT_NAME=飞灵
FLGO_ASSISTANT_DEFAULT_PROFILE=简洁、可靠、直接，优先给出可执行的回答。

# Feishu app and OAuth
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_NAME=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_AUTH_BASE_URL=https://accounts.feishu.cn
FEISHU_DOCS_BASE_URL=https://docs.feishu.cn
FEISHU_HTTP_PROXY=
FEISHU_OAUTH_SCOPES=auth:user.id:read drive:drive.search:readonly search:docs:read docx:document:readonly docx:document docs:document.media:download wiki:node:read wiki:wiki:readonly sheets:spreadsheet:readonly sheets:spreadsheet bitable:app:readonly bitable:app base:table:read base:record:read base:record:create base:record:update base:record:delete base:field:read base:view:read
FLGO_OAUTH_ENABLE_OFFLINE_ACCESS=false
FLGO_OAUTH_STATE_TTL_SECONDS=600

# Model routing
FLGO_DEFAULT_PROVIDER=gemini
FLGO_DEFAULT_MODEL=
FLGO_MODEL_TEST_MAX_OUTPUT_TOKENS=1024
FLGO_MODEL_PROVIDER_CONCURRENCY_LIMIT=4
FLGO_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
FLGO_OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=
FLGO_OPENAI_COMPATIBLE_HTTP_PROXY=

# Gemini provider
GEMINI_API_KEY=
GEMINI_DISPLAY_NAME=Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_THINKING_BUDGET=
GEMINI_BASE_URL=
GEMINI_HTTP_PROXY=

# OpenAI provider
OPENAI_API_KEY=
OPENAI_DISPLAY_NAME=OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_DISPLAY_NAME=DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen provider
QWEN_API_KEY=
QWEN_DISPLAY_NAME=Qwen
QWEN_BASE_URL=
QWEN_MODEL=

# Doubao provider
DOUBAO_API_KEY=
DOUBAO_DISPLAY_NAME=Doubao
DOUBAO_BASE_URL=
DOUBAO_MODEL=

# Minimax provider
MINIMAX_API_KEY=
MINIMAX_DISPLAY_NAME=Minimax
MINIMAX_BASE_URL=
MINIMAX_MODEL=

# Claude provider
ANTHROPIC_API_KEY=
ANTHROPIC_DISPLAY_NAME=Claude
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_HTTP_PROXY=

# Media and workflow providers
SEEDANCE_API_KEY=
SEEDANCE_DISPLAY_NAME=Seedance
SEEDANCE_BASE_URL=
SEEDANCE_MODEL=
COMFYUI_DISPLAY_NAME=ComfyUI
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COZE_API_KEY=
COZE_DISPLAY_NAME=Coze
COZE_BASE_URL=
DIFY_API_KEY=
DIFY_DISPLAY_NAME=Dify
DIFY_BASE_URL=

# Resource and attachment reading
FLGO_RESOURCE_SEARCH_ENABLED=true
FLGO_RESOURCE_SEARCH_RESULT_LIMIT=5
FLGO_RESOURCE_SEARCH_READ_LIMIT=3
FLGO_MAX_RESOURCE_CHARS=120000
FLGO_MAX_MESSAGE_CHARS=20000
FLGO_MAX_SHEET_ROWS=200
FLGO_MAX_SHEET_COLUMNS=26
FLGO_MAX_BITABLE_RECORDS=200
FLGO_DOC_BLOCK_SCAN_LIMIT=1000
FLGO_EMBEDDED_FILE_LIMIT=3
FLGO_EMBEDDED_FILE_MAX_BYTES=20971520
FLGO_EMBEDDED_FILE_MAX_CHARS=40000
FLGO_EMBEDDED_LINK_LIMIT=20
FLGO_ATTACHMENT_OCR_ENABLED=false
FLGO_ATTACHMENT_OCR_COMMAND=tesseract
FLGO_ATTACHMENT_OCR_LANGUAGES=chi_sim+eng
FLGO_ATTACHMENT_OCR_TIMEOUT_SECONDS=15
FLGO_ATTACHMENT_OCR_MAX_PIXELS=20000000
FLGO_ATTACHMENT_VISION_ENABLED=false
FLGO_ATTACHMENT_VISION_PROVIDER=gemini
FLGO_ATTACHMENT_VISION_MODEL=
FLGO_ATTACHMENT_VISION_PROMPT=请用中文简洁说明这张图片的内容；如果图片包含可读文字，请尽量完整转写关键文字。
FLGO_ATTACHMENT_VISION_MAX_BYTES=5242880
FLGO_ATTACHMENT_VISION_MAX_PIXELS=20000000
FLGO_ATTACHMENT_MEDIA_UNDERSTANDING_ENABLED=false
FLGO_ATTACHMENT_MEDIA_UNDERSTANDING_PROVIDER=gemini
FLGO_ATTACHMENT_MEDIA_UNDERSTANDING_MODEL=
FLGO_ATTACHMENT_MEDIA_UNDERSTANDING_PROMPT=请用中文简洁说明这个媒体文件的主要内容；如果是音频，请尽量转写关键语句；如果是视频，请概述画面和可听内容。
FLGO_ATTACHMENT_MEDIA_UNDERSTANDING_MAX_BYTES=20971520
FLGO_PDF_DEFAULT_PAGES=2
FLGO_PDF_MAX_PAGES=10
FLGO_PDF_EXTRACT_TIMEOUT_SECONDS=20

# Web reading
FLGO_WEB_READ_ENABLED=true
FLGO_WEB_TIMEOUT_SECONDS=20
FLGO_WEB_MAX_BYTES=1000000
FLGO_WEB_ALLOWED_HOSTS=
FLGO_WEB_BLOCKED_HOSTS=

# Context and memory
FLGO_CONTEXT_RECENT_MESSAGE_LIMIT=50
FLGO_CONTEXT_RECENT_TIME_WINDOW_HOURS=24
FLGO_CONTEXT_CACHE_TTL_HOURS=24
FLGO_CONTEXT_CACHE_REFRESH_SECONDS=60
FLGO_CONTEXT_INJECT_MESSAGE_LIMIT=8
FLGO_CONTEXT_MAX_CHARS=6000
FLGO_MEMORY_STORE_RAW_TEXT=false
FLGO_MEMORY_ITEM_MAX_CHARS=2000
FLGO_MEMORY_CONTEXT_MAX_CHARS=4000

# Writeback
FLGO_WRITEBACK_ENABLED=false
FLGO_WRITEBACK_AUTO_EXECUTE_ENABLED=false
FLGO_WRITEBACK_CONFIRMATION_MODE=always
FLGO_PENDING_ACTION_TTL_SECONDS=1800
FLGO_WRITEBACK_DEDUPE_WINDOW_SECONDS=600
FLGO_CARD_ACTION_ACK_TIMEOUT_SECONDS=2
FLGO_MAX_WRITEBACK_CHARS=20000
FLGO_MAX_WRITEBACK_CELLS=1000
