# Core runtime
FCGO_ENV=dev
FCGO_LOG_LEVEL=INFO
FCGO_HOST=127.0.0.1
FCGO_PORT=8000
FCGO_BASE_URL=http://127.0.0.1:8000
FCGO_SQLITE_PATH=data/fcgo.sqlite3
FCGO_START_LONG_CONNECTION=false
FCGO_ASSISTANT_DEFAULT_NAME=小智

# Model routing
# Current implemented providers: gemini, openai, deepseek, qwen, doubao, minimax, claude, echo.
FCGO_DEFAULT_PROVIDER=gemini
# Optional. Leave empty to use the provider's own default model.
FCGO_DEFAULT_MODEL=
# Test env defaults to this output-token cap when a provider-specific cap is unset.
# dev/prod do not apply a hard output-token cap unless provider-specific settings below are set.
FCGO_MODEL_TEST_MAX_OUTPUT_TOKENS=1024
# Maximum concurrent calls per provider. Set 0 to disable router-level concurrency limiting.
FCGO_MODEL_PROVIDER_CONCURRENCY_LIMIT=4

# Feishu custom app
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_NAME=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_AUTH_BASE_URL=https://accounts.feishu.cn
# Browser-openable Feishu document host used when search returns only resource tokens.
FEISHU_DOCS_BASE_URL=https://docs.feishu.cn
# Optional. Use this when Feishu OpenAPI calls fail due to local network TLS/proxy issues.
# Example: FEISHU_HTTP_PROXY=http://127.0.0.1:7890
FEISHU_HTTP_PROXY=
# Space- or comma-separated OAuth scopes requested when a user sends /授权.
# The user must also have access to the target Feishu resource.
FEISHU_OAUTH_SCOPES=auth:user.id:read drive:drive.search:readonly search:docs:read docx:document:readonly docx:document docs:document.media:download wiki:node:read wiki:wiki:readonly sheets:spreadsheet:readonly sheets:spreadsheet bitable:app:readonly bitable:app base:table:read base:record:read base:record:create base:record:update base:record:delete base:field:read base:view:read
# Set true only after the Feishu developer console grants offline_access to this app.
FCGO_OAUTH_ENABLE_OFFLINE_ACCESS=false
FCGO_OAUTH_STATE_TTL_SECONDS=600

# Gemini
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
# Optional cost cap. Leave unset in dev/prod if you do not want a hard output-token limit.
# GEMINI_MAX_OUTPUT_TOKENS=4096
# Optional. Leave unset for normal runtime quality. Use 0 only when you deliberately want
# to reduce Gemini 2.5 thinking-token usage.
# GEMINI_THINKING_BUDGET=0
GEMINI_BASE_URL=
# Optional. Use this when Google AI API is unavailable from the current network/region.
# Example: GEMINI_HTTP_PROXY=http://127.0.0.1:7890
GEMINI_HTTP_PROXY=

# OpenAI-compatible providers
# A provider is registered only when API_KEY, BASE_URL, and MODEL are all set.
# Set FCGO_DEFAULT_PROVIDER or use /模型 使用 provider/model in Feishu to switch.
FCGO_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
# Optional shared cost cap for OpenAI-compatible providers.
# FCGO_OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=4096
# Optional shared proxy for OpenAI-compatible providers.
# FCGO_OPENAI_COMPATIBLE_HTTP_PROXY=http://127.0.0.1:7890

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
# Optional. Use this when Anthropic API is unavailable from the current network/region.
# ANTHROPIC_HTTP_PROXY=http://127.0.0.1:7890

# Resource limits
FCGO_MAX_RESOURCE_CHARS=120000
FCGO_MAX_MESSAGE_CHARS=20000
FCGO_MAX_SHEET_ROWS=200
FCGO_MAX_SHEET_COLUMNS=26
FCGO_MAX_BITABLE_RECORDS=200
FCGO_DOC_BLOCK_SCAN_LIMIT=1000
FCGO_EMBEDDED_FILE_LIMIT=3
FCGO_EMBEDDED_FILE_MAX_BYTES=20971520
FCGO_EMBEDDED_FILE_MAX_CHARS=40000
FCGO_ATTACHMENT_OCR_ENABLED=false
FCGO_ATTACHMENT_OCR_COMMAND=tesseract
FCGO_ATTACHMENT_OCR_LANGUAGES=chi_sim+eng
FCGO_ATTACHMENT_OCR_TIMEOUT_SECONDS=15
FCGO_ATTACHMENT_OCR_MAX_PIXELS=20000000
FCGO_ATTACHMENT_VISION_ENABLED=false
FCGO_ATTACHMENT_VISION_PROVIDER=gemini
FCGO_ATTACHMENT_VISION_MODEL=
FCGO_ATTACHMENT_VISION_MAX_BYTES=5242880
FCGO_ATTACHMENT_VISION_MAX_PIXELS=20000000
FCGO_EMBEDDED_LINK_LIMIT=20
FCGO_PDF_DEFAULT_PAGES=2
FCGO_PDF_MAX_PAGES=10
FCGO_PDF_EXTRACT_TIMEOUT_SECONDS=20
FCGO_RESOURCE_SEARCH_ENABLED=true
FCGO_RESOURCE_SEARCH_RESULT_LIMIT=5
FCGO_RESOURCE_SEARCH_READ_LIMIT=3
FCGO_WEB_TIMEOUT_SECONDS=20

# Context and memory privacy defaults
# Recent chat context is enabled by default where Feishu OAuth scopes allow it.
FCGO_CONTEXT_RECENT_MESSAGE_LIMIT=50
FCGO_CONTEXT_RECENT_TIME_WINDOW_HOURS=24
FCGO_CONTEXT_CACHE_TTL_HOURS=24
FCGO_CONTEXT_CACHE_REFRESH_SECONDS=60
FCGO_CONTEXT_INJECT_MESSAGE_LIMIT=8
FCGO_CONTEXT_MAX_CHARS=6000
# Keep false to avoid persisting full chat, Feishu resource, web page, or attachment text.
FCGO_MEMORY_STORE_RAW_TEXT=false
FCGO_MEMORY_ITEM_MAX_CHARS=2000
FCGO_MEMORY_CONTEXT_MAX_CHARS=4000

# Agent runtime. Keep legacy until Agent mode passes manual Feishu acceptance.
FCGO_AGENT_MODE=legacy
FCGO_AGENT_MAX_STEPS=4
FCGO_AGENT_TOOL_TIMEOUT_SECONDS=30

# Writeback is off by default unless you are testing confirmed writeback.
FCGO_WRITEBACK_ENABLED=false
# Keeps user-level low-risk auto-writeback opt-in disabled by default.
FCGO_WRITEBACK_AUTO_EXECUTE_ENABLED=false
FCGO_WRITEBACK_CONFIRMATION_MODE=always
FCGO_PENDING_ACTION_TTL_SECONDS=1800
FCGO_WRITEBACK_DEDUPE_WINDOW_SECONDS=600
FCGO_CARD_ACTION_ACK_TIMEOUT_SECONDS=2
FCGO_MAX_WRITEBACK_CHARS=20000
FCGO_MAX_WRITEBACK_CELLS=1000
